+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.systemui.biometrics;
+
+import java.util.function.BooleanSupplier;
+
+/** Holds the optical sensor rate while interactive, and only during a scan in doze. */
+final class UdfpsRefreshRateController {
+    interface Scheduler {
+        Runnable after(Runnable action, long delayMillis);
+    }
+
+    // Allow two 120 Hz frames before illumination and outlast degas' 150 ms HBM off reassert.
+    private static final long SETTLE_MS = 20;
+    private static final long RELEASE_MS = 200;
+    private static final long TIMEOUT_MS = 800;
+
+    private final Scheduler scheduler;
+    private final BooleanSupplier modeReady;
+    private final Runnable enable;
+    private final Runnable disable;
+    private boolean visible;
+    private boolean dozing;
+    private boolean scanning;
+    private boolean held;
+    private int generation;
+    private Runnable pending;
+    private Runnable cancelSettle;
+    private Runnable cancelTimeout;
+    private Runnable cancelRelease;
+
+    UdfpsRefreshRateController(Scheduler scheduler, BooleanSupplier modeReady,
+            Runnable enable, Runnable disable) {
+        this.scheduler = scheduler;
+        this.modeReady = modeReady;
+        this.enable = enable;
+        this.disable = disable;
+    }
+
+    void setDozing(boolean value) {
+        dozing = value;
+        updateVote();
+    }
+
+    void setOverlayVisible(boolean value) {
+        visible = value;
+        if (!value) {
+            endScan();
+        } else {
+            updateVote();
+        }
+    }
+
+    void startScan(Runnable onReady, Runnable onTimeout) {
+        cancelPending();
+        scanning = true;
+        pending = onReady;
+        updateVote();
+        final int token = generation;
+        cancelTimeout = scheduler.after(() -> {
+            if (generation != token || pending == null) return;
+            cancelTimeout = null;
+            endScan();
+            onTimeout.run();
+        }, TIMEOUT_MS);
+        onDisplayChanged();
+    }
+
+    void endScan() {
+        cancelPending();
+        scanning = false;
+        updateVote();
+    }
+
+    void onDisplayChanged() {
+        if (pending == null) return;
+        if (!modeReady.getAsBoolean()) {
+            if (cancelSettle != null) cancelSettle.run();
+            cancelSettle = null;
+            // Invalidate a queued settlement, even if its cancellation raced delivery.
+            settleGeneration++;
+            return;
+        }
+        if (cancelSettle != null) return;
+        final int token = generation;
+        final int settleToken = ++settleGeneration;
+        cancelSettle = scheduler.after(() -> {
+            if (token != generation || settleToken != settleGeneration) return;
+            cancelSettle = null;
+            if (pending == null || !modeReady.getAsBoolean()) return;
+            final Runnable action = pending;
+            pending = null;
+            if (cancelTimeout != null) cancelTimeout.run();
+            cancelTimeout = null;
+            action.run();
+        }, SETTLE_MS);
+    }
+
+    private int settleGeneration;
+
+    private void cancelPending() {
+        generation++;
+        settleGeneration++;
+        pending = null;
+        if (cancelSettle != null) cancelSettle.run();
+        if (cancelTimeout != null) cancelTimeout.run();
+        cancelSettle = null;
+        cancelTimeout = null;
+    }
+
+    private void updateVote() {
+        if (visible && (!dozing || scanning)) {
+            releaseGeneration++;
+            if (cancelRelease != null) cancelRelease.run();
+            cancelRelease = null;
+            if (!held) {
+                held = true;
+                enable.run();
+            }
+        } else if (held && cancelRelease == null) {
+            final int token = ++releaseGeneration;
+            cancelRelease = scheduler.after(() -> {
+                if (token != releaseGeneration) return;
+                cancelRelease = null;
+                if (!held || (visible && (!dozing || scanning))) return;
+                held = false;
+                disable.run();
+            }, RELEASE_MS);
+        }
+    }
+
+    private int releaseGeneration;
+}
